<ContentPage
    x:Class="PostIt.Views.Blogs.ReplayEditorPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PostIt.ViewModels"
    xmlns:abs="using:Yavsc.Abstract.Streaming"
    x:DataType="vm:ReplayEditorPageViewModel">
    <Design.DataContext>
        <vm:ReplayEditorPageViewModel />
    </Design.DataContext>
    <Grid x:Name="EditorGrid" ColumnDefinitions="2*,*" RowDefinitions="Auto,*,Auto,Auto" Margin="16" ColumnSpacing="16" RowSpacing="8">
        <TextBlock x:Name="EditorTitle" Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="22" TextWrapping="Wrap" />
        <Border x:Name="VideoBorder" Grid.Row="1" Background="Black" BorderThickness="1" BorderBrush="Green" MinHeight="240">
            <ContentControl x:Name="VideoSurface" />
        </Border>
        <WrapPanel x:Name="PlaybackCommands" Grid.Row="2">
            <Button Content="◀ Image precedente" Click="PreviousFrame_Click" Margin="0,0,8,8"
                    AutomationProperties.Name="Reculer d'une image" />
            <Button Content="Image suivante ▶" Click="NextFrame_Click" Margin="0,0,8,8"
                    AutomationProperties.Name="Avancer d'une image" />
            <Button x:Name="AddMarkButton" Content="Ajouter une marque (Ctrl+M)" Command="{Binding AddMarkCommand}" HotKey="Ctrl+M" Margin="0,0,8,8" />
            <TextBlock Text="{Binding CurrentTime, StringFormat='Position : {0}'}" VerticalAlignment="Center" />
        </WrapPanel>
        <TextBlock x:Name="PlaybackStatus" Grid.Row="3" TextWrapping="Wrap" />
        <ScrollViewer x:Name="EditPanel" Grid.Row="1" Grid.RowSpan="3" Grid.Column="1">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding DraftState}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DurationSummary}" TextWrapping="Wrap" />
                <TextBlock Text="Marques" FontWeight="SemiBold" />
                <TextBlock Text="Les temps sont ceux de la source originale. Les miniatures restent locales et sont effacees en quittant l'editeur. Une marque nommee devient un chapitre du replay publie."
                           TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Marks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReplayMarkItem">
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Image Source="{Binding Thumbnail}" Width="96" Height="54" Stretch="Uniform" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Time}" FontWeight="SemiBold" />
                                            <TextBlock Text="(supprimee)" IsVisible="{Binding IsRemoved}" />
                                            <TextBlock Text="✓ selectionnee" IsVisible="{Binding IsSelected}" />
                                        </StackPanel>
                                        <TextBox Text="{Binding Title}" Watermark="Titre du chapitre (facultatif)"
                                                 MaxLength="{x:Static abs:ReplayEditPlan.MaxChapterTitleLength}"
                                                 IsEnabled="{Binding $parent[ContentPage].((vm:ReplayEditorPageViewModel)DataContext).CanEdit}" />
                                        <WrapPanel>
                                            <Button Content="Aller" Margin="0,0,4,4"
                                                    Command="{Binding $parent[ContentPage].((vm:ReplayEditorPageViewModel)DataContext).GoToMarkCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Debut" Margin="0,0,4,4"
                                                    Command="{Binding $parent[ContentPage].((vm:ReplayEditorPageViewModel)DataContext).SetRangeStartCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Fin" Margin="0,0,4,4"
                                                    Command="{Binding $parent[ContentPage].((vm:ReplayEditorPageViewModel)DataContext).SetRangeEndCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Retirer" Margin="0,0,4,4"
                                                    Command="{Binding $parent[ContentPage].((vm:ReplayEditorPageViewModel)DataContext).RemoveMarkCommand}"
                                                    CommandParameter="{Binding}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Retirer toutes les marques" Command="{Binding ClearMarksCommand}" />
                <TextBlock Text="Plage a supprimer" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap" />
                <WrapPanel>
                    <Button Content="Supprimer cette plage" Command="{Binding RemoveSelectionCommand}" Margin="0,0,8,8" />
                    <Button Content="Annuler la selection" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="Plages supprimees" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding RemovedRanges}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReplayRangeItem">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Content="Retablir"
                                        Command="{Binding $parent[ContentPage].((vm:ReplayEditorPageViewModel)DataContext).RestoreRangeCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel>
                    <Button Content="Enregistrer le brouillon" Command="{Binding SaveCommand}" Margin="0,0,8,8" />
                    <Button Content="Recharger" Command="{Binding ReloadCommand}" Margin="0,0,8,8" />
                    <Button Content="Publier" Command="{Binding PublishCommand}" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="La publication enregistre d'abord les modifications, puis remplace le replay une fois le MP4 prepare."
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentPage>
