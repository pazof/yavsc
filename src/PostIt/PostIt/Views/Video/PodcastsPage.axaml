<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PostIt.ViewModels"
             xmlns:services="using:PostIt.Services"
             xmlns:streaming="clr-namespace:Yavsc.Abstract.Streaming;assembly=Yavsc.Abstract"
             x:Class="PostIt.Views.PodcastsPage"
             x:DataType="vm:PodcastsPageViewModel"
             Header="Podcasts">
              <ContentPage.Styles>
        <Style Selector="Border.warning-danger">
            <Setter Property="Background" Value="#862C05"/>
            <Setter Property="BorderBrush" Value="#A5EDC2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="TextBlock.warning-danger">
            <Setter Property="Background" Value="#862C05"/>
            <Setter Property="Foreground" Value="#AAFF00"/>
        </Style>

        <Style Selector="TextBlock.warning-title">
            <Setter Property="Background" Value="#862C05"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="CheckBox.warning-check">
            <Setter Property="Background" Value="#862C05"/>
            <Setter Property="Foreground" Value="#FFF7F4"/>
        </Style>

        <Style Selector="Button.delete-danger">
            <Setter Property="Background" Value="#862C05"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style Selector="Button.delete-danger:pointerover">
            <Setter Property="Background" Value="#FFCB64"/>
            <Setter Property="Foreground" Value="#03963E"/>
        </Style>

        <Style Selector="Button.delete-danger:disabled">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
    </ContentPage.Styles>
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12" MaxWidth="900">
            <TextBlock Text="Podcasts : directs et replays" FontSize="22" />
            <TextBlock Text="Lecture et emission reservees aux utilisateurs connectes. Quitter cette page arrete la capture." TextWrapping="Wrap" />
            <StackPanel Spacing="8" IsEnabled="{Binding !IsBroadcasting}">
                <TextBlock Text="Preparer une emission" FontWeight="SemiBold" />
                <TextBox Text="{Binding Title, Mode=TwoWay}" PlaceholderText="Titre de l'emission" MaxLength="160" />
                <TextBlock Text="Debut prevu (heure locale)" />
                <DatePicker SelectedDate="{Binding ScheduledDate, Mode=TwoWay}" />
                <TimePicker SelectedTime="{Binding ScheduledTime, Mode=TwoWay}" />
                <TextBlock Text="Duree prevue en minutes" />
                <NumericUpDown Value="{Binding PlannedDurationMinutes, Mode=TwoWay}" Minimum="1" Maximum="2147483647" Increment="1" />
                <CheckBox Content="Publier une annonce visible sans connexion sur Yavsc.Org"
                          IsChecked="{Binding PublishAnnouncement, Mode=TwoWay}" />
                <TextBox Text="{Binding Announcement, Mode=TwoWay}" MaxLength="1023" AcceptsReturn="True"
                         IsVisible="{Binding PublishAnnouncement}" PlaceholderText="Annonce publique (ne pas inclure d'informations privees)" />
                <TextBlock Text="Sans annonce, la preparation est privee. Les horaires sont previsionnels : demarrage et arret manuels. L'ecoute reste reservee aux utilisateurs connectes."
                           TextWrapping="Wrap" />
                <WrapPanel>
                    <Button Content="Nouvelle emission / direct immediat" Command="{Binding NewPlanCommand}" Margin="0,0,8,8" />
                    <Button Content="Preparer une nouvelle emission" Command="{Binding PrepareCommand}" Margin="0,0,8,8" />
                    <Button Content="Enregistrer les modifications de l'emission selectionnee" Command="{Binding UpdatePlanCommand}" />
                </WrapPanel>
            </StackPanel>
            <StackPanel Spacing="8" IsVisible="{Binding HasCapturePreview}">
                <TextBlock Text="Apercu local de la capture" FontWeight="SemiBold" />
                <Border Background="Black" CornerRadius="4" ClipToBounds="True">
                    <ContentControl x:Name="CapturePreviewHost" Content="{Binding CapturePreview}" Height="300"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </Border>
            </StackPanel>
            <StackPanel Spacing="8" IsVisible="{Binding CanBroadcast}" IsEnabled="{Binding !IsBroadcasting}">
                <Button Content="Detecter cameras et microphones" Command="{Binding DetectDevicesCommand}" />
                <ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" PlaceholderText="Camera"
                          IsEnabled="{Binding !IsCapturing}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="services:CaptureDevice"><TextBlock Text="{Binding Name}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" PlaceholderText="Microphone">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="services:CaptureDevice"><TextBlock Text="{Binding Name}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <WrapPanel>
                    <Button Content="Previsualiser la camera" Command="{Binding PreviewCommand}" Margin="0,0,8,8" />
                    <Button Content="Arreter la previsualisation" Command="{Binding StopPreviewCommand}" Margin="0,0,8,8" />
                    <Button Content="Demarrer le direct" Command="{Binding StartCommand}" />
                </WrapPanel>
            </StackPanel>
            <Button Content="Arreter et publier le replay" Command="{Binding StopCommand}" />
            <StackPanel Spacing="8">
                <TextBlock Text="Diffuser l'emission programmee avec OBS Studio" FontWeight="SemiBold" />
                <TextBlock Text="Selectionnez votre emission puis activez OBS. Dans OBS : service Personnalise, video H.264, audio AAC, images cles toutes les 2 secondes. Le direct commence lorsque OBS se connecte, pas a l'heure prevue."
                           TextWrapping="Wrap" />
                <WrapPanel>
                    <Button Content="Activer OBS / renouveler la cle" Command="{Binding ActivateObsCommand}" Margin="0,0,8,8" />
                    <Button Content="Revoquer OBS et arreter le diffuseur" Command="{Binding DeactivateObsCommand}" />
                </WrapPanel>
                <TextBlock Text="Serveur OBS" />
                <TextBox Text="{Binding ObsServerUrl, Mode=OneWay}" IsReadOnly="True" />
                <TextBlock Text="Cle de stream (secrete : ne pas partager)" />
                <TextBox Text="{Binding ObsStreamKey, Mode=OneWay}" IsReadOnly="True" />
                <TextBlock Text="{Binding ObsStatus}" TextWrapping="Wrap" />
                <TextBlock Text="Les identifiants ne sont pas sauvegardes dans PostIt. Quitter la page masque la cle, mais n'arrete pas OBS : utilisez la revocation ou arretez OBS."
                           TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Content="Garder l'ecran allume pendant l'apercu camera et le direct"
                      IsVisible="{Binding SupportsCaptureScreenAwake}"
                      IsChecked="{Binding KeepScreenOnDuringCapture, Mode=TwoWay}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            <Button Content="Actualiser les directs et replays" Command="{Binding RefreshCommand}" />
            <ListBox ItemsSource="{Binding Podcasts}" SelectedItem="{Binding SelectedPodcast}" MinHeight="160" MaxHeight="420"
                     SelectionChanged="PodcastSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="streaming:PodcastResponse">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding OwnerName}" />
                                <TextBlock Text="{Binding State}" />
                                <TextBlock Text="{Binding DurationSeconds, StringFormat='{}{0:0} s'}" />
                                <TextBlock Text="{Binding Replay.State, StringFormat='MP4 : {0}'}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Replay.Error}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ScheduledStartAt, StringFormat='Debut prevu : {0:g}'}" />
                            <TextBlock Text="{Binding PlannedDurationMinutes, StringFormat='Duree prevue : {0} min'}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel>
                <Button Content="Regarder le direct / replay" Command="{Binding PlayCommand}" Margin="0,0,8,8" />
                <Button Content="Terminer mon direct selectionne" Command="{Binding FinishCommand}" Margin="0,0,8,8" />
                <Button Content="Relancer la preparation MP4" Command="{Binding RetryReplayCommand}" Margin="0,0,8,8" />
            </WrapPanel>
             <Border Classes="warning-danger">
                <StackPanel Spacing="8">
                    <TextBlock Classes="warning-title" Text="⚠ Suppression du podcast / emission preparee" />
                    <TextBlock Text="Cette action supprime définitivement le podcast ou l'émission préparée sélectionnée. Cette opération est irréversible."
                               TextWrapping="Wrap"  />
                    <CheckBox x:Name="ConfirmDelete"
                              Classes="warning-check"
                              Content="Je confirme la suppression du podcast sélectionné" />
                    <Button Classes="delete-danger"
                            Content="Supprimer mon podcast"
                            Command="{Binding DeleteCommand}"
                            IsEnabled="{Binding #ConfirmDelete.IsChecked}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentPage>
