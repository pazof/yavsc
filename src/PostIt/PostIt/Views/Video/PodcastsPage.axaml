<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PostIt.ViewModels"
             xmlns:services="using:PostIt.Services"
             xmlns:streaming="clr-namespace:Yavsc.Abstract.Streaming;assembly=Yavsc.Abstract"
             x:Class="PostIt.Views.PodcastsPage"
             x:DataType="vm:PodcastsPageViewModel"
             Header="Podcasts">
              <ContentPage.Styles>
        <Style Selector="Border.warning-danger">
            <Setter Property="Background" Value="#862C05"/>
            <Setter Property="BorderBrush" Value="#A5EDC2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="TextBlock.warning-danger">
            <Setter Property="Background" Value="#862C05"/>
            <Setter Property="Foreground" Value="#AAFF00"/>
        </Style>

        <Style Selector="TextBlock.warning-title">
            <Setter Property="Background" Value="#862C05"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="CheckBox.warning-check">
            <Setter Property="Background" Value="#862C05"/>
            <Setter Property="Foreground" Value="#FFF7F4"/>
        </Style>

        <Style Selector="Button.delete-danger">
            <Setter Property="Background" Value="#862C05"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style Selector="Button.delete-danger:pointerover">
            <Setter Property="Background" Value="#FFCB64"/>
            <Setter Property="Foreground" Value="#03963E"/>
        </Style>

        <Style Selector="Button.delete-danger:disabled">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
    </ContentPage.Styles>
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12" MaxWidth="900">
            <TextBlock Text="Podcasts : directs et replays" FontSize="22" />
            <TextBlock Text="Lecture et emission reservees aux utilisateurs connectes. Quitter cette page arrete la capture." TextWrapping="Wrap" />
            <StackPanel Spacing="8" IsVisible="{Binding IsBroadcasting}">
                <TextBlock Text="Apercu local de la capture" FontWeight="SemiBold" />
                <Border Background="Black" CornerRadius="4" ClipToBounds="True">
                    <ContentControl x:Name="CapturePreviewHost" Content="{Binding CapturePreview}" Height="300"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </Border>
            </StackPanel>
            <StackPanel Spacing="8" IsVisible="{Binding CanBroadcast}" IsEnabled="{Binding !IsBroadcasting}">
                <TextBox Text="{Binding Title}" PlaceholderText="Titre du direct" MaxLength="160" />
                <Button Content="Detecter cameras et microphones" Command="{Binding DetectDevicesCommand}" />
                <ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" PlaceholderText="Camera">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="services:CaptureDevice"><TextBlock Text="{Binding Name}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" PlaceholderText="Microphone">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="services:CaptureDevice"><TextBlock Text="{Binding Name}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Demarrer le direct" Command="{Binding StartCommand}" />
            </StackPanel>
            <Button Content="Arreter et publier le replay" Command="{Binding StopCommand}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            <Button Content="Actualiser les directs et replays" Command="{Binding RefreshCommand}" />
            <ListBox ItemsSource="{Binding Podcasts}" SelectedItem="{Binding SelectedPodcast}" MinHeight="160" MaxHeight="420"
                     SelectionChanged="PodcastSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="streaming:PodcastResponse">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding OwnerName}" />
                                <TextBlock Text="{Binding State}" />
                                <TextBlock Text="{Binding DurationSeconds, StringFormat='{}{0:0} s'}" />
                                <TextBlock Text="{Binding Replay.State, StringFormat='MP4 : {0}'}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Replay.Error}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel>
                <Button Content="Regarder le direct / replay" Command="{Binding PlayCommand}" Margin="0,0,8,8" />
                <Button Content="Terminer mon direct selectionne" Command="{Binding FinishCommand}" Margin="0,0,8,8" />
                <Button Content="Relancer la preparation MP4" Command="{Binding RetryReplayCommand}" Margin="0,0,8,8" />
            </WrapPanel>
             <Border Classes="warning-danger">
                <StackPanel Spacing="8">
                    <TextBlock Classes="warning-title" Text="⚠ Suppression du replay" />
                    <TextBlock Text="Cette action supprime définitivement le replay sélectionné. Cette opération est irréversible."
                               TextWrapping="Wrap"  />
                    <CheckBox x:Name="ConfirmDelete"
                              Classes="warning-check"
                              Content="Je confirme la suppression du replay sélectionné" />
                    <Button Classes="delete-danger"
                            Content="Supprimer mon replay"
                            Command="{Binding DeleteCommand}"
                            IsEnabled="{Binding #ConfirmDelete.IsChecked}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentPage>
