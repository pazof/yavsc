<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PostIt.ViewModels"
             x:Class="PostIt.Views.ConfirmationDialog"
             x:DataType="vm:ConfirmationDialogViewModel"
             Header="Confirmation">
  <Border Margin="20" Padding="20" CornerRadius="10" BorderBrush="#D0D7DE" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
    <StackPanel Spacing="14" MaxWidth="420">
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" />
        <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Classes="danger" />
      </StackPanel>
    </StackPanel>
  </Border>
</ContentPage>
