<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PostIt.ViewModels"
             xmlns:controls="using:PostIt.Controls"
             xmlns:dto="using:Yavsc.Api.Client"
             xmlns:postitControls="using:PostIt.Controls"
             x:Class="PostIt.Views.EstimateValidationPage"
             x:DataType="vm:EstimateValidationPageViewModel"
             Header="Validation du devis">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,8">
            <TextBlock Text="{Binding Title}"
                       FontSize="20"
                       FontWeight="Bold"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding RoleLabel}" Opacity="0.75" />
            <TextBlock Text="{Binding ValidationStateText}"
                       FontSize="11"
                       Opacity="0.75"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="10">
                <Border BorderThickness="1"
                        BorderBrush="#22000000"
                        CornerRadius="8"
                        Padding="10">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,12,*">
                            <TextBlock Grid.Column="0"
                                       Text="N°"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding EstimateId}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,12,*">
                            <TextBlock Grid.Column="0"
                                       Text="Type"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CommandType}" />
                        </Grid>
                        <TextBlock Text="{Binding Description}"
                                   TextWrapping="Wrap"
                                   Opacity="0.85" />
                    </StackPanel>
                </Border>

                <Border BorderThickness="1"
                        BorderBrush="#22000000"
                        CornerRadius="8"
                        Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Lignes du devis" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Bill}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dto:EstimateLineDto">
                                    <Grid ColumnDefinitions="*,8,60,8,120" Margin="0,0,0,4">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Count}"
                                                   HorizontalAlignment="Right" />
                                        <StackPanel Grid.Column="4"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Spacing="4">
                                            <TextBlock Text="{Binding UnitaryCost, StringFormat='{}{0:N2}'}" />
                                            <TextBlock Text="{Binding Currency}" Opacity="0.7" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border BorderThickness="1"
                        BorderBrush="#22000000"
                        CornerRadius="8"
                        Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Signature" FontWeight="SemiBold" />
                        <TextBlock Text="Signez ci-dessous pour valider ce devis."
                                   FontSize="11"
                                   Opacity="0.7" />
                        <controls:SignaturePadView x:Name="Pad"
                                                   CaptureWidth="560"
                                                   CaptureHeight="200" />
                        <TextBlock FontSize="11"
                                   Foreground="DarkSlateGray">
                            <Run Text="Traits: " />
                            <Run Text="{Binding StrokeCount, Mode=OneWay}" />
                            <Run Text="  ·  Points: " />
                            <Run Text="{Binding PointCount, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Content="Effacer"
                        Command="{Binding ClearSignatureCommand}" />
                <Button Content="Valider"
                        Command="{Binding ValidateCommand}" />
                <Button Content="Refuser"
                        Command="{Binding RejectCommand}" />
                <Button Content="Retour"
                        Command="{Binding BackCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <ProgressBar Width="120"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}" />
                <postitControls:StatusBar DataContext="{Binding ActionStatus}" />
            </StackPanel>
        </Grid>
    </Grid>
</ContentPage>