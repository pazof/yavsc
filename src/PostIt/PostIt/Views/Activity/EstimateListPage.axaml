<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PostIt.ViewModels"
             xmlns:dto="using:Yavsc.Api.Client"
             xmlns:postitControls="using:PostIt.Controls"
             x:Class="PostIt.Views.EstimateListPage"
             x:DataType="vm:EstimateListPageViewModel"
             Header="{Binding Title}">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">
        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding Subtitle}" Opacity="0.75" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,8,*" Margin="0,10,0,8">
            <Button Grid.Column="0" Content="Rafraîchir" Command="{Binding RefreshCommand}" />
            <TextBox Grid.Column="2"
                     PlaceholderText="Filtrer: titre, description, type, partie..."
                     Text="{Binding FilterText, Mode=TwoWay}" />
        </Grid>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Estimates}"
                 SelectedItem="{Binding SelectedEstimate, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="dto:EstimateDto">
                    <Border BorderThickness="1"
                            BorderBrush="#22000000"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,8">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding Title}"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding Id}"
                                       FontSize="11"
                                       Opacity="0.75"
                                       HorizontalAlignment="Right" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,6,0,0"
                                       Text="{Binding Description}"
                                       FontSize="11"
                                       Opacity="0.75"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="0,6,0,0"
                                       Text="{Binding Bill.Count}"
                                       FontSize="11"
                                       Opacity="0.65"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <postitControls:StatusBar Grid.Column="0"
                                      DataContext="{Binding ActionStatus}" />
            <ProgressBar Grid.Column="1" Width="120" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        </Grid>
    </Grid>
</ContentPage>
