<ContentPage
  x:Class="PostIt.Views.Chat.ChatPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:md="using:MarkdownViewer.Core.Controls"
  xmlns:models="using:Yavsc.Blogspot"
  xmlns:postitControls="using:PostIt.Controls"
  xmlns:views="using:PostIt.Views.Chat"
  xmlns:vm="using:PostIt.ViewModels.Chat"
  xmlns:services="using:PostIt.Services"
  x:DataType="vm:ChatViewModel"
  >
  <Design.DataContext>
    <vm:ChatViewModel />
  </Design.DataContext>

  <Grid Margin="10" RowDefinitions="Auto, *, Auto, Auto, Auto">

    <Grid
      Grid.Row="1"
      Margin="0,0,0,10"
      ColumnDefinitions="*, 200">

      <!--  Journal des flux de messages & notifications  -->
      <Grid Grid.Column="0" RowDefinitions="Auto, *">
        <StackPanel
          Grid.Row="0"
          Margin="0,0,0,5"
          Orientation="Horizontal"
          Spacing="10">
          <TextBox
            Width="200"
            VerticalAlignment="Center"
            Text="{Binding CurrentRoom}"
            PlaceholderText="Nom du salon" />
          <Button Command="{Binding JoinRoomCommand}" Content="Rejoindre Salon (Join)" />
          <Button Command="{Binding LeaveRoomCommand}" Content="Quitter le salon" IsEnabled="{Binding !!SelectedRoom}" />
          <!--  Choix de la salle en focus parmi celles jointes  -->
          <ComboBox
            Width="180"
            VerticalAlignment="Center"
            ItemsSource="{Binding JoinedRooms}"
            PlaceholderText="Salle active"
            SelectedItem="{Binding SelectedRoom}" />
        </StackPanel>

        <ListBox
          Grid.Row="1"
          BorderBrush="#E0E0E0"
          BorderThickness="1"
          ItemsSource="{Binding FocusedMessages}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!--  Liste des utilisateurs présents (MàJ via l'événement 'joint')  -->
      <Border
        Grid.Column="1"
        Margin="10,0,0,0"
        BorderBrush="#E0E0E0"
        BorderThickness="1">
        <Grid RowDefinitions="Auto, *">
          <TextBlock
            Grid.Row="0"
            Margin="5"
            HorizontalAlignment="Center"
            FontWeight="Bold"
            Text="Membres Présents" />
          <ListBox
            Grid.Row="1"
            BorderThickness="0"
            ItemsSource="{Binding FocusedUsers}" />
        </Grid>
      </Border>
    </Grid>
    <!--  Saisie et envoi d'un message dans le salon joint  -->
    <Grid
      Grid.Row="2"
      Margin="0,0,0,10"
      ColumnDefinitions="*, Auto">
      <TextBox
        Grid.Column="0"
        VerticalAlignment="Center"
        AcceptsReturn="False"
        IsEnabled="{Binding !!SelectedRoom}"
        PlaceholderText="Votre message..."
        Text="{Binding MessageToSend}">
        <TextBox.KeyBindings>
          <KeyBinding Command="{Binding SendMessageCommand}" Gesture="Enter" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button
        Grid.Column="1"
        Margin="10,0,0,0"
        VerticalAlignment="Center"
        Command="{Binding SendMessageCommand}"
        Content="Envoyer" />
    </Grid>

    <ScrollViewer Grid.Row="3" MaxHeight="520" Margin="0,0,0,8">
    <StackPanel>
    <TextBlock Text="Invitation WebRTC recue : ouvrez le panneau WebRTC pour repondre."
               IsVisible="{Binding VideoCall.Incoming}" TextWrapping="Wrap" />
    <TextBlock Text="Invitation SRTP directe recue : ouvrez le panneau d'appel direct pour repondre."
               IsVisible="{Binding LanCall.Incoming}" TextWrapping="Wrap" />
    <Expander Header="Appel video WebRTC" IsVisible="{Binding SupportsVideoCalls}" IsExpanded="True"
              IsEnabled="{Binding IsConnected}" Margin="0,0,0,8">
      <StackPanel DataContext="{Binding VideoCall}" x:DataType="vm:WebRtcCallViewModel" Spacing="8">
        <TextBlock Text="Android et Linux : medias chiffres par WebRTC (DTLS-SRTP), ICE/STUN/TURN. Activez le masquage IP dans votre profil pour imposer un relais TURN aux deux participants, sans repli direct. La camera et le microphone ne demarrent qu'apres acceptation."
                   TextWrapping="Wrap" />
        <WrapPanel IsEnabled="{Binding CanConfigure}" IsVisible="{Binding !RemoteVideo}">
          <Button Content="Actualiser les peripheriques" Command="{Binding RefreshDevicesCommand}" Margin="0,0,8,4" />
          <ComboBox Width="190" ItemsSource="{Binding Cameras}" SelectedItem="{Binding Camera}"
                    PlaceholderText="Camera" Margin="0,0,8,4">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="services:CaptureDevice">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Width="190" ItemsSource="{Binding Microphones}" SelectedItem="{Binding Microphone}"
                    PlaceholderText="Microphone" Margin="0,0,8,4">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="services:CaptureDevice">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBox Width="170" Text="{Binding Target}" PlaceholderText="Pseudo du pair" Margin="0,0,8,4" />
        </WrapPanel>
        <CheckBox Content="Si le masquage IP est desactive, je consens a partager mon adresse IP avec le pair."
                  IsChecked="{Binding AllowAddressDisclosure}" IsEnabled="{Binding CanConfigure}"
                  IsVisible="{Binding !RemoteVideo}" />
        <WrapPanel>
          <Button Content="Appeler dans la salle active" Command="{Binding InviteCommand}" IsEnabled="{Binding !Busy}" Margin="0,0,8,4" />
          <Button Content="Accepter" Command="{Binding AcceptCommand}" IsEnabled="{Binding Incoming}" Margin="0,0,8,4" />
          <Button Content="Refuser / Raccrocher" Command="{Binding HangupCommand}" IsEnabled="{Binding Busy}" Margin="0,0,8,4" />
        </WrapPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,2*" Height="280" IsVisible="{Binding !!RemoteVideo}">
          <ContentControl Content="{Binding LocalVideo}" Margin="0,0,8,0" />
          <ContentControl Grid.Column="1" Content="{Binding RemoteVideo}" />
        </Grid>
      </StackPanel>
    </Expander>

    <Expander Header="Appel direct IPv4/IPv6 SRTP (LAN/VPN ou IP publique)"
              IsVisible="{Binding SupportsLanCalls}" IsExpanded="True"
              IsEnabled="{Binding IsConnected}">
      <StackPanel DataContext="{Binding LanCall}" x:DataType="vm:LanCallViewModel" Spacing="8">
        <TextBlock Text="Connexion directe sans TURN ni traversee NAT : le pair connait votre IP. Le masquage IP doit etre desactive dans les profils des deux participants. Les medias sont chiffres par SRTP. Ouvrez le port UDP pair choisi et le suivant ; HTTPS est requis pour la signalisation. Casque recommande."
                   TextWrapping="Wrap" />
        <WrapPanel IsEnabled="{Binding CanConfigure}" IsVisible="{Binding !RemoteVideo}">
          <Button Content="Actualiser les peripheriques" Command="{Binding RefreshDevicesCommand}" Margin="0,0,8,4" />
          <ComboBox Width="160" ItemsSource="{Binding Addresses}" SelectedItem="{Binding Address}"
                    PlaceholderText="Adresse IPv4/IPv6 de cette machine" Margin="0,0,8,4" />
          <TextBox Width="80" Text="{Binding Port}" PlaceholderText="Port pair" Margin="0,0,8,4" />
          <ComboBox Width="190" ItemsSource="{Binding Cameras}" SelectedItem="{Binding Camera}"
                    PlaceholderText="Camera" Margin="0,0,8,4">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="services:CaptureDevice">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Width="190" ItemsSource="{Binding Microphones}" SelectedItem="{Binding Microphone}"
                    PlaceholderText="Microphone" Margin="0,0,8,4">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="services:CaptureDevice">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBox Width="170" Text="{Binding Target}" PlaceholderText="Pseudo du pair" Margin="0,0,8,4" />
        </WrapPanel>
        <CheckBox Content="Je consens a partager mon adresse IP avec le pair."
                  IsChecked="{Binding AllowAddressDisclosure}" IsEnabled="{Binding CanConfigure}"
                  IsVisible="{Binding !RemoteVideo}" />
        <WrapPanel>
          <Button Content="Appeler dans la salle active" Command="{Binding InviteCommand}" IsEnabled="{Binding !Busy}" Margin="0,0,8,4" />
          <Button Content="Accepter" Command="{Binding AcceptCommand}" IsEnabled="{Binding Incoming}" Margin="0,0,8,4" />
          <Button Content="Refuser / Raccrocher" Command="{Binding HangupCommand}" IsEnabled="{Binding Busy}" Margin="0,0,8,4" />
        </WrapPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,2*" Height="280" IsVisible="{Binding !!RemoteVideo}">
          <ContentControl Content="{Binding LocalVideo}" Margin="0,0,8,0" />
          <ContentControl Grid.Column="1" Content="{Binding RemoteVideo}" />
        </Grid>
      </StackPanel>
    </Expander>
    </StackPanel>
    </ScrollViewer>

    <postitControls:StatusBar
      x:Name="StatusBar"
      Grid.Row="4"
      DataContext="{Binding Status}" />

  </Grid>
</ContentPage>
