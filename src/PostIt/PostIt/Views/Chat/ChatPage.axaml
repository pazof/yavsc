<ContentPage
  x:Class="PostIt.Views.Chat.ChatPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:postitControls="using:PostIt.Controls"
  xmlns:vm="using:PostIt.ViewModels.Chat"
  x:DataType="vm:ChatViewModel"
  >
  <Design.DataContext>
    <vm:ChatViewModel />
  </Design.DataContext>

  <Grid Margin="10" RowDefinitions="Auto, *, Auto, Auto, Auto">

    <Grid
      Grid.Row="1"
      Margin="0,0,0,10"
      ColumnDefinitions="*, 200">

      <!--  Journal des flux de messages & notifications  -->
      <Grid Grid.Column="0" RowDefinitions="Auto, *">
        <StackPanel
          Grid.Row="0"
          Margin="0,0,0,5"
          Orientation="Horizontal"
          Spacing="10">
          <TextBox
            Width="200"
            VerticalAlignment="Center"
            Text="{Binding CurrentRoom}"
            PlaceholderText="Nom du salon" />
          <Button Command="{Binding JoinRoomCommand}" Content="Rejoindre Salon (Join)" />
          <Button Command="{Binding LeaveRoomCommand}" Content="Quitter le salon" IsEnabled="{Binding IsConnectedAndInARoom}" />
          <!--  Choix de la salle en focus parmi celles jointes  -->
          <ComboBox
            Width="180"
            VerticalAlignment="Center"
            ItemsSource="{Binding JoinedRooms}"
            PlaceholderText="Salle active"
            SelectedItem="{Binding SelectedRoom}" />
        </StackPanel>

        <ListBox
          Grid.Row="1"
          BorderBrush="#E0E0E0"
          BorderThickness="1"
          ItemsSource="{Binding FocusedMessages}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!--  Liste des utilisateurs présents (MàJ via l'événement 'joint')  -->
      <Border
        Grid.Column="1"
        Margin="10,0,0,0"
        BorderBrush="#E0E0E0"
        BorderThickness="1">
        <Grid RowDefinitions="Auto, *, Auto">
          <TextBlock
            Grid.Row="0"
            Margin="5"
            HorizontalAlignment="Center"
            FontWeight="Bold"
            Text="Membres Présents" />
          <ListBox
            Grid.Row="1"
            BorderThickness="0"
            ItemsSource="{Binding FocusedUsers}"
            SelectedItem="{Binding SelectedUser}" />
          <Button Grid.Row="2" Margin="5" Content="Ouvrir l'appel"
                  Command="{Binding OpenCallCommand}" />
        </Grid>
      </Border>
    </Grid>
    <!--  Saisie et envoi d'un message dans le salon joint  -->
    <Grid
      Grid.Row="2"
      Margin="0,0,0,10"
      ColumnDefinitions="*, Auto">
      <TextBox
        Grid.Column="0"
        VerticalAlignment="Center"
        AcceptsReturn="False"
        IsEnabled="{Binding IsConnectedAndInARoom}"
        PlaceholderText="Votre message..."
        Text="{Binding MessageToSend}">
        <TextBox.KeyBindings>
          <KeyBinding Command="{Binding SendMessageCommand}" Gesture="Enter" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button
        Grid.Column="1"
        Margin="10,0,0,0"
        VerticalAlignment="Center"
        Command="{Binding SendMessageCommand}"
        Content="Envoyer" />
    </Grid>

    <StackPanel Grid.Row="3" Margin="0,0,0,8" Spacing="4">
      <Button Content="Repondre a l'invitation WebRTC" Command="{Binding ShowCallCommand}"
              IsVisible="{Binding VideoCall.Incoming}" />
      <Button Content="Repondre a l'invitation SRTP directe" Command="{Binding ShowCallCommand}"
              IsVisible="{Binding LanCall.Incoming}" />
    </StackPanel>

    <postitControls:StatusBar
      x:Name="StatusBar"
      Grid.Row="4"
      DataContext="{Binding Status}" />

  </Grid>
</ContentPage>
