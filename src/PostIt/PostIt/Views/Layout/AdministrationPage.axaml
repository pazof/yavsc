<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PostIt.ViewModels"
             xmlns:resources="using:Yavsc.Abstract.Resources"
             x:Class="PostIt.Views.AdministrationPage"
             x:DataType="vm:AdministrationPageViewModel"
             Header="Administration">

  <Grid RowDefinitions="Auto,Auto,*" Margin="16" RowSpacing="12">
    <TextBlock Grid.Row="0"
               Text="Administration"
               FontSize="22"
               FontWeight="SemiBold"/>

    <StackPanel Grid.Row="1" Spacing="8">
      <TextBox Text="{Binding SearchText, Mode=TwoWay}"
               PlaceholderText="Rechercher un utilisateur..."/>
      <Button Content="Actualiser"
              Command="{Binding RefreshCommand}"
              IsEnabled="{Binding !IsBusy}"/>
      <ProgressBar IsVisible="{Binding IsBusy}"
                   IsIndeterminate="True"
                   Height="8"/>
      <TextBlock Text="{Binding StatusMessage}"
                 TextWrapping="Wrap"/>
    </StackPanel>

    <TabControl Grid.Row="2">
      <TabItem Header="Utilisateurs">
        <Grid ColumnDefinitions="1.3*,0.7*" ColumnSpacing="12">
          <ListBox ItemsSource="{Binding FilteredUsers}"
                   SelectedItem="{Binding SelectedUser, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="8" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding UserName, StringFormat='Nom : {0}'}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FullName, StringFormat='Nom complet : {0}'}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Email, StringFormat='Email : {0}'}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DedicatedGoogleCalendar, StringFormat='Calendrier : {0}'}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding UserId, StringFormat='ID : {0}'}" Foreground="#4B5563" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ScrollViewer Grid.Column="1">
            <Border Padding="12" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
              <StackPanel Spacing="8">
                <TextBlock Text="Détails" FontWeight="SemiBold" FontSize="18"/>
                <TextBlock Text="{Binding SelectedUser.UserName, StringFormat='Nom d’utilisateur : {0}'}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedUser.FullName, StringFormat='Nom complet : {0}'}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedUser.Email, StringFormat='Email : {0}'}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedUser.Address, StringFormat='Adresse : {0}'}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedUser.DedicatedGoogleCalendar, StringFormat='Calendrier : {0}'}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedUser.BankInfoSummary, StringFormat='Banque : {0}'}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedUser.UserId, StringFormat='ID : {0}'}" Foreground="#4B5563" TextWrapping="Wrap"/>
                <StackPanel DataContext="{Binding SelectedUsage}" Spacing="4">
                  <TextBlock Text="Usage des ressources" FontWeight="Bold"/>
                  <TextBlock Text="{Binding ApiCalls, StringFormat='Appels API : {0:F0}'}"/>
                  <TextBlock Text="{Binding CpuSeconds, StringFormat='CPU : {0:F3} s'}"/>
                  <TextBlock Text="{Binding BandwidthMb, StringFormat='Bande passante : {0:F3} Mo'}"/>
                  <TextBlock Text="{Binding StorageMb, StringFormat='Stockage : {0:F3} Mo'}"/>
                  <TextBlock Text="{Binding EstimatedCompensation, StringFormat='Estimation : {0:F2}'}"/>
                  <TextBlock Text="{Binding Currency}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Usages">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding UsageOverview}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="resources:ResourceUsageSummary">
                <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
                        BorderBrush="#D0D7DE" BorderThickness="1">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding UserName}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding UserId}"/>
                    <TextBlock Text="{Binding ApiCalls, StringFormat='Appels API : {0:F0}'}"/>
                    <TextBlock Text="{Binding CpuSeconds, StringFormat='CPU : {0:F3} s'}"/>
                    <TextBlock Text="{Binding BandwidthMb, StringFormat='Bande passante : {0:F3} Mo'}"/>
                    <TextBlock Text="{Binding StorageMb, StringFormat='Stockage : {0:F3} Mo'}"/>
                    <TextBlock Text="{Binding EstimatedCompensation, StringFormat='Estimation : {0:F2}'}"/>
                    <TextBlock Text="{Binding Currency}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</ContentPage>
