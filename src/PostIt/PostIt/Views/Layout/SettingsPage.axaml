<ContentPage
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="cl:avalonia.Controls"
    xmlns:postitControls="using:PostIt.Controls"
        x:Class="PostIt.Views.SettingsPage"
        xmlns:vm="using:PostIt.ViewModels"
        x:DataType="vm:Settings"
      >
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Authority"/>
        <TextBox Grid.Row="1" x:Name="AuthorityTextBox"
        Text="{Binding Authentication.Authority, Mode=TwoWay}"/>

        <TextBlock Grid.Row="2" Text="ClientId"/>
        <TextBox Grid.Row="3" x:Name="ClientIdTextBox"
        Text="{Binding Authentication.ClientId, Mode=TwoWay}"/>

        <TextBlock Grid.Row="4" Text="Scopes (space-separated)"/>
        <TextBox Grid.Row="5" x:Name="ScopesTextBox"
        Text="{Binding Authentication.ScopeListText, Mode=TwoWay}"/>

        <TextBlock Grid.Row="6" Text="Blogs API URL"/>
        <TextBox Grid.Row="7" x:Name="BlogsApiUrlTextBox"
        Text="{Binding BlogsApiUrl, Mode=TwoWay}"/>

        <TextBlock Grid.Row="8" Text="API URL"/>
        <TextBox Grid.Row="9" x:Name="BusinessApiUrlTextBox"
        Text="{Binding ApiUrl, Mode=TwoWay}"/>

        <TextBlock Grid.Row="10" Text="Dark mode"/>
        <CheckBox Grid.Row="11" x:Name="DarkModeCheckBox" IsChecked="{Binding DarkMode, Mode=TwoWay}"/>

        <StackPanel Grid.Row="12" Spacing="8">
            <TextBlock Text="Moyens de contact" FontWeight="SemiBold" />
            <CheckBox Content="Autoriser les appels audio"
                      IsChecked="{Binding AllowAudioCalls, Mode=TwoWay}" />
            <CheckBox Content="Autoriser les appels audio-video"
                      IsChecked="{Binding AllowVideoCalls, Mode=TwoWay}" />
            <CheckBox Content="Autoriser les messages prives"
                      IsChecked="{Binding AllowPrivateMessages, Mode=TwoWay}" />
            <TextBlock Text="Ces preferences sont annoncees au serveur a la connexion et a la reconnexion. Leur application aux appels et aux messages n'est pas encore implementee ; elles ne bloquent donc pas les contacts."
                       TextWrapping="Wrap" />
            <StackPanel IsVisible="{Binding SupportsBackgroundChatService}" Spacing="6">
                <CheckBox x:Name="BackgroundChatCheckBox"
                          Content="Garder la connexion au serveur active et la reprendre au demarrage du telephone"
                          IsChecked="{Binding AndroidKeepChatConnected, Mode=TwoWay}" />
                <TextBlock Text="SignalR uniquement, sans notification permanente. Les alertes s'affichent seulement a reception d'un message ou evenement. Sauver avec cette option active demande l'exemption batterie Android seulement si PostIt n'est pas deja exempte. Vous restez libre de refuser. Autorisez aussi les donnees en arriere-plan dans Android. Ces reglages ne garantissent pas la survie du service ni sa reprise au demarrage. Sans cette option, la connexion dure pendant la vie du processus PostIt."
                           TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Content="Partager les exceptions techniques avec Yavsc"
                      IsChecked="{Binding ShareExceptionReports, Mode=TwoWay}" />
            <TextBlock Text="Desactive par defaut. Si vous activez cette option, PostIt transmet le type, le message et la trace technique des exceptions signalees pour aider au diagnostic. Ces details peuvent contenir des informations issues de l'environnement de l'application."
                       TextWrapping="Wrap" />
            <TextBlock Text="Avatar: PNG, JPG/JPEG, WEBP, GIF. Taille max 2 MB."
                   Opacity="0.8"
                   TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ChooseAvatarButton"
                Content="Choisir l'avatar"
                    Click="ChooseAvatar_Click"
                    Margin="0,0,8,0"/>

            <Button Content="Sauver"
                    Command="{Binding ApplyCommand}"
                    IsEnabled="{Binding IsDirty}"/>
                </StackPanel>
        </StackPanel>

    </Grid>
    </ScrollViewer>
</ContentPage>
