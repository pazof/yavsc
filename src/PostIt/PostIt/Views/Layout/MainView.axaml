<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PostIt.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PostIt.Views.MainView"
             x:DataType="vm:HomePageViewModel">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
    to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:HomePageViewModel />
  </Design.DataContext>

  <Grid>
    <NavigationPage x:Name="NavRoot"/>

    <Border x:Name="NotificationToast"
            IsVisible="False"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="16"
            CornerRadius="10"
            Padding="12"
            BorderThickness="1"
            BorderBrush="#5B8DEF"
            Background="#E8F0FE"
            BoxShadow="0 6 16 0 #26000000"
            PointerPressed="NotificationToast_PointerPressed">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <TextBlock x:Name="NotificationToastGlyph"
                   VerticalAlignment="Center"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#1E3A8A"
                   Text="✓"/>
        <TextBlock x:Name="NotificationToastMessage"
                   Grid.Column="1"
                   MaxWidth="420"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Foreground="#1E3A8A"
                   Text=""/>
      </Grid>
    </Border>

    <Border x:Name="NotificationModal"
            IsVisible="False"
            Background="#80000000"
            Padding="12"
            KeyboardNavigation.TabNavigation="Cycle">
      <Border MaxWidth="420"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Padding="20"
              CornerRadius="8"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <StackPanel Spacing="12">
          <TextBlock x:Name="NotificationModalTitle"
                     FontSize="22"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Text="Notification"/>
          <SelectableTextBlock x:Name="NotificationModalMessage"
                               TextWrapping="Wrap"
                               Text=""/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="NotificationModalCloseButton"
                    Content="Fermer"
                    Click="NotificationModalCloseButton_Click"/>
            <Button x:Name="NotificationModalActionButton"
                    IsVisible="False"
                    Click="NotificationModalActionButton_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border x:Name="AuthenticationModal"
            IsVisible="{Binding SessionStatus.IsAuthenticationRequired, FallbackValue=False}"
            Background="#80000000"
            Padding="12"
            KeyboardNavigation.TabNavigation="Cycle">
      <Border MaxWidth="420"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Padding="20"
              CornerRadius="8"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              AutomationProperties.Name="Connexion requise">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <TextBlock Text="Connexion requise" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="PostIt nécessite une connexion. Connectez-vous pour continuer." TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SessionStatus.SessionLabel}" TextWrapping="Wrap"/>
            <ProgressBar Height="4" IsIndeterminate="True" IsVisible="{Binding SessionStatus.IsBusy}"/>
            <Button x:Name="LoginButton" Content="Se connecter"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SessionStatus.LoginCommand}"/>
            <Button x:Name="RegisterButton" Content="Créer un compte"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SessionStatus.RegisterCommand}"/>
            <Button x:Name="ForgotPasswordButton" Content="Mot de passe oublié"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SessionStatus.ForgotPasswordCommand}"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>
  </Grid>
</UserControl>
