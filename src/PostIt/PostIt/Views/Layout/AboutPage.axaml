<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PostIt.ViewModels"
             x:Class="PostIt.Views.AboutPage"
             x:DataType="vm:AboutPageViewModel"
             Header="À propos">
    <Design.DataContext>
        <vm:AboutPageViewModel />
    </Design.DataContext>
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Margin="16">
        <TextBlock Text="PostIt"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding Version, StringFormat='Version {0}'}"
                   HorizontalAlignment="Center"
                   Opacity="0.8"/>
        <TextBlock Text="{Binding Description}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="420"/>
        <TextBlock Text="{Binding License}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="420"
                   Opacity="0.8"
                   FontStyle="Italic"/>
        <Button Content="Dépôt du projet"
                Command="{Binding OpenRepositoryCommand}"
                HorizontalAlignment="Center"/>
        <Button Content="Signaler un problème"
                Command="{Binding OpenIssuesCommand}"
                HorizontalAlignment="Center"/>
        <Button Content="CGU de PostIt et de Yavsc"
                Command="{Binding OpenTermsCommand}"
                HorizontalAlignment="Center"/>
        <Button Content="Abonnements Découverte et Premium"
                Command="{Binding OpenSubscriptionsCommand}"
                HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" MaxWidth="420"/>
    </StackPanel>
</ContentPage>
