<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PostIt.ViewModels"
             xmlns:lang="using:Yavsc.Lang"
             x:Class="PostIt.Views.HomePage"
             x:DataType="vm:HomePageViewModel"
             Header="Home">
             <Design.DataContext>
                  <vm:HomePageViewModel />
              </Design.DataContext>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                <TextBlock Text="{x:Static lang:Resources.GreetingText}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

          <Button Content="Les Salons de discussion"
                  Command="{Binding OpenChat}"
                  HorizontalAlignment="Center"
                  IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Open Blog Interface"
                  Command="{Binding OpenBlogs}"
                  HorizontalAlignment="Center"
                  IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Parcourir les activités"
              Command="{Binding OpenActivities}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Mes demandes en cours"
              Command="{Binding OpenProviderRequests}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Devis en attente de signature client"
              Command="{Binding OpenClientEstimates}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Devis en attente de signature fournisseur"
              Command="{Binding OpenProviderEstimates}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Mes fichiers"
              Command="{Binding OpenMyFiles}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Mon profil"
              Command="{Binding OpenProfile}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Mon activité / performer"
              Command="{Binding OpenPerformerConfiguration}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Administration"
              Command="{Binding OpenAdministration}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Mon usage / administration"
              Command="{Binding OpenResourceUsage}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
        </StackPanel>
</ContentPage>
