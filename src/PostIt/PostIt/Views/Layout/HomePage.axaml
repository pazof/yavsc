<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PostIt.ViewModels"
             xmlns:lang="using:Yavsc.Lang"
             xmlns:messaging="using:Yavsc.Abstract.Models.Messaging"
             x:Class="PostIt.Views.HomePage"
             x:DataType="vm:HomePageViewModel"
             Header="Home">
             <Design.DataContext>
                  <vm:HomePageViewModel />
              </Design.DataContext>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" Spacing="12" MaxWidth="720"
                    HorizontalAlignment="Stretch">
                <TextBlock Text="{x:Static lang:Resources.GreetingText}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Notifications" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Actualiser"
                    Command="{Binding RefreshNotificationsCommand}"
                    IsEnabled="{Binding !IsLoadingNotifications}"/>
          </Grid>
          <ProgressBar IsIndeterminate="True" Height="4"
                       IsVisible="{Binding IsLoadingNotifications}"/>
          <TextBlock Text="{Binding NotificationsError}" TextWrapping="Wrap"
                     Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
          <TextBlock Text="Aucune notification pour le moment."
                     IsVisible="{Binding HasNoNotifications}" TextWrapping="Wrap"/>
          <ItemsControl x:Name="NotificationsList" ItemsSource="{Binding Notifications}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="messaging:Notification">
                <Border Padding="12" Margin="0,0,0,8" CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding title}" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding body}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Content="Les Salons de discussion"
                  Command="{Binding OpenChat}"
                  HorizontalAlignment="Center"
                  IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Open Blog Interface"
                  Command="{Binding OpenBlogs}"
                  HorizontalAlignment="Center"
                  IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Parcourir les activités"
              Command="{Binding OpenActivities}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Mes demandes en cours"
              Command="{Binding OpenProviderRequests}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Devis en attente de signature client"
              Command="{Binding OpenClientEstimates}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Devis en attente de signature fournisseur"
              Command="{Binding OpenProviderEstimates}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Mes fichiers"
              Command="{Binding OpenMyFiles}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Mon profil"
              Command="{Binding OpenProfile}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Mon activité / performer"
              Command="{Binding OpenPerformerConfiguration}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Administration"
              Command="{Binding OpenAdministration}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
          <Button Content="Mon usage / administration"
              Command="{Binding OpenResourceUsage}"
              HorizontalAlignment="Center"
              IsEnabled="{Binding SessionStatus.IsLoggedIn}"/>
        </StackPanel>
        </ScrollViewer>
</ContentPage>
