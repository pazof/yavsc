<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cvm="using:PostIt.ViewModels.Commands"
             xmlns:mapsui="using:Mapsui.UI.Avalonia"
             x:Class="PostIt.Views.Commands.AddressEditorPage"
             x:DataType="cvm:PhysicalAddressViewModel"
             Header="Adresse">
  <Grid RowDefinitions="Auto,*" MaxWidth="760" Margin="16">
    <StackPanel Grid.Row="0" Spacing="10">
      <TextBlock Text="Adresse" FontWeight="SemiBold" />
      <TextBox Text="{Binding Address, Mode=TwoWay}" />

      <Button Content="Utiliser ma position"
              HorizontalAlignment="Stretch"
              Click="OnUseCurrentLocationClicked"
              IsEnabled="{Binding CanUseCurrentLocation}" />

      <StackPanel x:Name="SuggestedAddressPanel" Spacing="8" IsVisible="{Binding HasSuggestedAddressPanel}">
        <TextBlock Text="{Binding SuggestedAddress, StringFormat='Adresse suggérée: {0}'}"
                   TextWrapping="Wrap"
                   Opacity="0.8" />
        <Button x:Name="ApplySuggestedAddressButton"
                Content="Utiliser"
                HorizontalAlignment="Stretch"
                IsVisible="{Binding HasSuggestedAddress}"
                Command="{Binding ApplySuggestedAddressCommand}" />
        <ProgressBar x:Name="SuggestedAddressProgress"
                     Height="4"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsResolvingAddress}" />
      </StackPanel>

      <Grid ColumnDefinitions="*,12,*">
        <Button Grid.Column="0"
                Content="Retour"
                HorizontalAlignment="Stretch"
                Click="OnBackClicked" />
        <Button Grid.Column="2"
                Content="Valider"
                HorizontalAlignment="Stretch"
                Click="OnValidateClicked" />
      </Grid>
    </StackPanel>

    <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="8" ClipToBounds="True">
      <StackPanel Spacing="6">
        <TextBlock Text="Carte: cliquez pour positionner le rendez-vous"
                   TextWrapping="Wrap"
                   Opacity="0.85" />
        <mapsui:MapControl x:Name="LocationMap"
                           Height="360" />
      </StackPanel>
    </Border>
  </Grid>
</ContentPage>
