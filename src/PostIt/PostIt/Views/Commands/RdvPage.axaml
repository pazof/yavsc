<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cvm="using:PostIt.ViewModels.Commands"
             xmlns:mapsui="using:Mapsui.UI.Avalonia"
             x:Class="PostIt.Views.Commands.RdvPage"
             x:DataType="cvm:RdvViewModel"
             Header="Commande billing">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" Spacing="10" MaxWidth="760">
      <TextBlock Text="{Binding Title}"
                 FontSize="22"
                 FontWeight="Bold"
                 TextWrapping="Wrap" />

      <TextBlock Text="{Binding SupportMessage}"
                 Margin="0,0,0,6"
                 TextWrapping="Wrap"
                 Opacity="0.8" />

      <TextBlock Text="Utilisateur" FontWeight="SemiBold" />
      <TextBox Text="{Binding PerformerLabel}" IsReadOnly="True" />

      <TextBlock Text="Activité" FontWeight="SemiBold" />
      <TextBox Text="{Binding ActivityLabel}" IsReadOnly="True" />

      <TextBlock Text="Date" FontWeight="SemiBold" />
      <DatePicker DayFormat="ddd dd"
                  SelectedDate="{Binding EventDateSelection, Mode=TwoWay}" />

      <TextBlock Text="Motif" FontWeight="SemiBold" />
      <TextBox Text="{Binding Reason, Mode=TwoWay}" />

      <TextBlock Text="Adresse" FontWeight="SemiBold" />
      <TextBox Text="{Binding PhysicalAddress.Address}" IsReadOnly="True" />
      <Button Content="Modifier l'adresse sur la carte"
              HorizontalAlignment="Stretch"
              Click="OnEditAddressClicked" />

      <StackPanel Spacing="8" IsVisible="{Binding HasSuggestedAddressPanel}">
        <TextBlock Text="{Binding SuggestedAddress, StringFormat='Adresse suggérée: {0}'}"
                   TextWrapping="Wrap"
                   Opacity="0.8" />
        <Button Content="Utiliser"
                HorizontalAlignment="Stretch"
                IsVisible="{Binding HasSuggestedAddress}"
                Command="{Binding ApplySuggestedAddressCommand}" />
        <ProgressBar Height="4"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsResolvingAddress}" />
      </StackPanel>

      <Button Content="Utiliser ma position"
              HorizontalAlignment="Stretch"
              Command="{Binding UseCurrentLocationCommand}" />

      <TextBlock Text="Latitude" FontWeight="SemiBold" />
      <TextBox Text="{Binding Latitude}" IsReadOnly="True" PlaceholderText="Optionnel" />

      <TextBlock Text="Longitude" FontWeight="SemiBold" />
      <TextBox Text="{Binding Longitude}" IsReadOnly="True" PlaceholderText="Optionnel" />

      <TextBlock Text="Informations" FontWeight="SemiBold" />
      <TextBox Text="{Binding AdditionalInfo, Mode=TwoWay}" />

      <CheckBox IsChecked="{Binding Consent, Mode=TwoWay}"
                Margin="0,4,0,0">
        <TextBlock Text="Je consens à la création de cette commande"
                   TextWrapping="Wrap" />
      </CheckBox>

      <Button Content="{Binding SubmitLabel}"
              HorizontalAlignment="Stretch"
              Command="{Binding SubmitCommand}"
              IsEnabled="{Binding IsSupported}" />
      <ProgressBar Height="4"
                   IsIndeterminate="True"
                   IsVisible="{Binding IsBusy}" />
    </StackPanel>
  </ScrollViewer>
</ContentPage>
