<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PostIt.ViewModels"
             xmlns:client="using:Yavsc.Api.Client"
             xmlns:postitControls="using:PostIt.Controls"
             x:Class="PostIt.Views.MyFilesPage"
             x:DataType="vm:MyFilesViewModel"
             Header="Mes fichiers">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">
        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="{Binding PathLabel}"
                       FontSize="20"
                       FontWeight="Bold" />
            <TextBlock Text="Espace de stockage personnel. Téléversez vos fichiers puis attachez-les à un devis ou une demande."
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,8,Auto,8,*" Margin="0,10,0,8">
            <Button Grid.Column="0"
                    Content="Retour"
                    Command="{Binding BackCommand}" />
            <Button Grid.Column="2"
                    Content="Remonter"
                    Command="{Binding UpCommand}"
                    IsEnabled="{Binding CanGoUp}" />
            <Button Grid.Column="4"
                    Content="Téléverser…"
                    Click="Upload_Click"
                    HorizontalAlignment="Right" />
        </Grid>

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="10">
                <ItemsControl ItemsSource="{Binding SubDirectories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="client:DirEntryDto">
                            <Button Content="📁 {Binding Name}"
                                    Command="{Binding $parent[vm:MyFilesViewModel].OpenDirCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Files}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="client:FileEntryDto">
                            <Border BorderThickness="1"
                                    BorderBrush="#22000000"
                                    CornerRadius="6"
                                    Padding="8"
                                    Margin="0,0,0,6">
                                <Grid ColumnDefinitions="*,Auto,8,Auto,8,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap" />
                                    <Button Grid.Column="1"
                                            Content="Joindre"
                                            Command="{Binding $parent[vm:MyFilesViewModel].PickFileCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding $parent[vm:MyFilesViewModel].IsPickerMode}" />
                                    <Button Grid.Column="3"
                                            Content="Télécharger"
                                            Command="{Binding $parent[vm:MyFilesViewModel].DownloadFileCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="5"
                                            Content="Supprimer"
                                            Command="{Binding $parent[vm:MyFilesViewModel].DeleteFileCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,8,*,Auto" Margin="0,12,0,0">
            <postitControls:StatusBar Grid.Column="0"
                                       DataContext="{Binding ActionStatus}" />
            <ProgressBar Grid.Column="3"
                         Width="120"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsBusy}" />
        </Grid>
    </Grid>
</ContentPage>