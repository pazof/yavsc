<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PostIt.Controls.ReplayControls"
             Background="Transparent">
    <Border x:Name="ControlBar" Background="#CC151515" Padding="12"
            VerticalAlignment="Bottom">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button x:Name="ToggleButton" Content="Pause" Click="Toggle_Click"
                    AutomationProperties.Name="Lecture ou pause du replay" />
            <Slider x:Name="PositionSlider" Grid.Column="1" Minimum="0" Maximum="1"
                    ValueChanged="Position_Changed" VerticalAlignment="Center"
                    AutomationProperties.Name="Position dans le replay" />
            <TextBlock x:Name="TimeLabel" Grid.Column="2" Foreground="White"
                       VerticalAlignment="Center" Text="0:00 / 0:00" />
        </Grid>
    </Border>
</UserControl>
