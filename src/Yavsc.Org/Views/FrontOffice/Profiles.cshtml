@model IEnumerable<PerformerProfileViewModel>
  
@{
    ViewBag.Title = (ViewBag.Activity?.Name ?? "Any") ;
    var activityCode = ViewBag.Activity?.Code as string;
    var performerId = ViewBag.PerformerId as string;
    var permalinkExpiry = ViewBag.PermalinkExpiry is DateTimeOffset expiry ? expiry : DateTimeOffset.MinValue;
}
<h1>@ViewBag.Title</h1>
<em>@ViewBag.Activity.Description</em>

@if (!string.IsNullOrWhiteSpace(performerId) && !string.IsNullOrWhiteSpace(activityCode))
{
    <div class="alert alert-info d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mt-3" role="alert">
        <div>
            <div class="fw-semibold">Permalien public</div>
            <small class="text-muted">Valable jusqu'au @permalinkExpiry.ToLocalTime().ToString("g")</small>
        </div>
        <button type="button" class="btn btn-primary" onclick="copyPermalink()">
            Copier le permalien
        </button>
    </div>
}

@foreach (var profile in Model) {
    <hr/>
   @Html.DisplayFor(m=>profile)
    <a class="btn btn-success" asp-controller="Command" asp-action="Create" asp-route-proId="@profile.PerformerId"
    asp-route-billingCode="Profiles" asp-route-activityCode="@ViewBag.Activity.Code"  >
    Proposer un rendez-vous à @profile.UserName
    </a>
}

<script>
    function copyPermalink() {
        const url = '@(ViewBag.Permalink ?? string.Empty)';
        if (!url) return;

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).catch(() => fallbackCopy(url));
            return;
        }

        fallbackCopy(url);
    }

    function fallbackCopy(value) {
        const temp = document.createElement('textarea');
        temp.value = value;
        temp.setAttribute('readonly', '');
        temp.style.position = 'fixed';
        temp.style.left = '-9999px';
        document.body.appendChild(temp);
        temp.select();
        document.execCommand('copy');
        document.body.removeChild(temp);
    }
</script>

