@model UnregisterViewModel
@{
    ViewBag.Title = "Supprimer mon compte";
}

<h2>@ViewBag.Title</h2>

<div class="row">
    <div class="col-md-8">
        <p>
            Cette action ferme définitivement votre compte et vous déconnecte. Le retrait est confirmé
            après résiliation des abonnements et suppression de vos fichiers personnels, avatars et podcasts.
            Vos identifiants sont effacés ou pseudonymisés. En cas d'erreur, le compte est bloqué et
            l'administration doit reprendre l'effacement ; aucun retrait réussi n'est annoncé.
            Les données techniques de paiement restent conservées jusqu'à un an après le retrait effectif.
            Les pièces comptables relèvent d'une conservation légale distincte.
            Consultez la <a asp-controller="Home" asp-action="Privacy">politique de confidentialité</a>.
        </p>

        <form asp-controller="Account" asp-action="Delete" method="post" class="form-horizontal" role="form">
            @Html.Hidden("UserId")
            <button type="submit" class="btn btn-danger">Confirmer la suppression</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-default">Annuler</a>
        </form>
    </div>
</div>