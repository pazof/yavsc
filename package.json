{
  "name": "yavsc",
  "version": "0.0.0",
  "private": true,
  "description": "Yavsc front-end toolchain (esbuild bundles for Yavsc.Org).",
  "scripts": {
    "build:js": "node esbuild.config.mjs",
    "build:podcasts": "node -e \"require('node:fs').copyFileSync('node_modules/hls.js/dist/hls.light.min.js', 'src/Yavsc.Org/wwwroot/js/hls.light.min.js')\"",
    "build:js:watch": "node esbuild.config.mjs --watch",
    "clean:js": "node esbuild.config.mjs --clean"
  },
  "dependencies": {
    "bootstrap": "^4.6.2",
    "jquery": "^3.7.1",
    "jquery-ui": "^1.13.3",
    "jquery-validation": "^1.20.0",
    "jquery-validation-unobtrusive": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
